{
  "name": "Banking observability",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
